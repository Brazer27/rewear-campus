# Copy this file to .env before running the project.
# These DB_HOST and DB_PORT values are for running the backend on your host machine.
# Docker Compose overrides them to db:5432 inside the app container.
APP_PORT=3000
ADMINER_PORT=8080
DB_HOST=127.0.0.1
DB_PORT=5433
DB_HOST_PORT=5433
POSTGRES_DB=rewear_db
POSTGRES_USER=rewear_user
POSTGRES_PASSWORD=change_this_password_for_local_development
